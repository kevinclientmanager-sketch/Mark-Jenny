# MARK IMTI - Environment Variables (never hardcode production secrets)
# Copy to .env and fill

# Backend
DATABASE_URL=sqlite:///./mark_jenny.db
# For Postgres: postgresql://user:pass@host:5432/markjenny
SECRET_KEY=change_me_generate_via_python_-c_"import secrets; print(secrets.token_urlsafe(32))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# AI Providers (configure via /ai/providers UI - encrypted)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws

# Optional Redis for multi-process/cloud
# REDIS_URL=redis://localhost:6379/0
