# Mark-Imti Configuration
# 
# NO .env FILE IS NEEDED!
# All configuration is managed through the Settings UI in the app.
# API keys are stored encrypted in the credential vault.
#
# This file is just for documentation — you can safely delete it.
#
# Cloud-first model runtime. Store secrets in the deployment environment, never in source control.
# MARK_IMTI_MODEL_RUNTIME_MODE=cloud
# MARK_IMTI_CLOUD_MODEL_BASE_URL=https://api.openai.com/v1
# MARK_IMTI_CLOUD_MODEL_API_KEY=your-provider-key
# MARK_IMTI_CLOUD_MODEL_NAME=gpt-4o-mini
# For local/offline mode, use MARK_IMTI_MODEL_RUNTIME_MODE=local and optionally:
# MARK_IMTI_OLLAMA_BASE_URL=http://localhost:11434
# MARK_IMTI_OLLAMA_MODEL=qwen3:8b
#
# If you need to override the data directory, set this environment variable:
# MARK_IMTI_DATA=C:\path\to\data
